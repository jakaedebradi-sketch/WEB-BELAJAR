        function handleLogin(event) {
            event.preventDefault();
            const name = document.getElementById('user-name').value.trim();
            const nim = document.getElementById('user-nim').value.trim();
            const role = document.getElementById('user-role').value;

            if (!name || !nim) return;

            currentUser = { name, nim, role };
            localStorage.setItem('kurpeng_username', name);
            localStorage.setItem('kurpeng_nim', nim);
            localStorage.setItem('kurpeng_role', role);

            document.getElementById('login-modal').classList.add('hidden');
            document.getElementById('app-container').classList.remove('hidden');

            updateUserDisplay();
            loadSessionContent(1);
            loadQuizSession(1);
        }

        function logout() {
            localStorage.clear();
            location.reload();
        }

