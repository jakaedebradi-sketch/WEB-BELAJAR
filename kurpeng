        // Initialization on Load
        window.addEventListener('DOMContentLoaded', () => {
            const savedName = localStorage.getItem('kurpeng_username');
            const savedNim = localStorage.getItem('kurpeng_nim');
            const savedRole = localStorage.getItem('kurpeng_role');

            if (savedName && savedNim) {
                currentUser = { name: savedName, nim: savedNim, role: savedRole };
                document.getElementById('login-modal').classList.add('hidden');
                document.getElementById('app-container').classList.remove('hidden');
