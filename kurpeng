            selectedOptionIndex = null;
        }

        function selectQuizOption(selectedIndex, btnElement) {
            if (selectedOptionIndex !== null) return; // already answered
            selectedOptionIndex = selectedIndex;

            const questions = quizData[currentQuizSession];
            const q = questions[currentQuizIndex];
            const isCorrect = (selectedIndex === q.answer);

            if (isCorrect) currentScore += 10;
            document.getElementById('current-score').textContent = currentScore;

            // Style buttons
            const allBtns = document.getElementById('quiz-options-area').children;
            for (let i = 0; i < allBtns.length; i++) {
                allBtns[i].disabled = true;
                if (i === q.answer) {
                    allBtns[i].classList.remove('bg-white', 'hover:bg-ocean-50');
                    allBtns[i].classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-900');
                    allBtns[i].querySelector('i').className = "fa-solid fa-circle-check text-emerald-600";
                } else if (i === selectedIndex && !isCorrect) {
                    allBtns[i].classList.remove('bg-white', 'hover:bg-ocean-50');
                    allBtns[i].classList.add('bg-rose-50', 'border-rose-500', 'text-rose-900');
                    allBtns[i].querySelector('i').className = "fa-solid fa-circle-xmark text-rose-600";
                }
            }

            const feedbackEl = document.getElementById('quiz-feedback');
            if (isCorrect) {
                feedbackEl.className = "text-sm font-bold text-emerald-600 flex items-center gap-2";
                feedbackEl.innerHTML = `<i class="fa-solid fa-check-circle"></i> <span>Jawaban Benar! ${q.explanation}</span>`;
            } else {
                feedbackEl.className = "text-sm font-bold text-rose-600 flex items-center gap-2";
                feedbackEl.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> <span>Jawaban Kurang Tepat. ${q.explanation}</span>`;
            }

            document.getElementById('quiz-footer').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQuizIndex++;
            loadQuizQuestion();
        }

        function showQuizResults() {
            const arena = document.getElementById('quiz-arena');
            arena.innerHTML = `
                <div class="text-center py-10 space-y-6">
                    <div class="w-20 h-20 mx-auto rounded-3xl ocean-gradient text-white flex items-center justify-center text-3xl font-bold shadow-lg">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div class="space-y-2">
                        <h3 class="text-2xl font-extrabold text-ocean-950">Asesmen Sesi ${currentQuizSession} Selesai!</h3>
                        <p class="text-sm text-ocean-700">Anda telah menyelesaikan seluruh 15 soal asesmen kuis untuk sesi ini.</p>
                    </div>
                    <div class="inline-block p-6 rounded-2xl bg-ocean-50 border border-ocean-200">
                        <div class="text-xs uppercase font-bold text-ocean-600">Total Skor Anda</div>
                        <div class="text-4xl font-extrabold text-ocean-900 mt-1">${currentScore} <span class="text-base font-medium text-ocean-600">/ 150</span></div>
                    </div>
                    <div class="flex flex-wrap justify-center gap-3 pt-4">
                        <button onclick="startQuizSession(${currentQuizSession})" class="px-6 py-3 bg-ocean-100 text-ocean-700 hover:bg-ocean-200 font-bold rounded-xl text-sm transition">
                            <i class="fa-solid fa-rotate-right"></i> Ulangi Kuis Sesi Ini
                        </button>
                        <button onclick="openCertificateModal()" class="px-6 py-3 ocean-gradient text-white font-bold rounded-xl text-sm shadow-md hover:opacity-95 transition">
                            <i class="fa-solid fa-certificate"></i> Lihat & Unduh Sertifikat
                        </button>
                    </div>
                </div>
            `;
        }

        // Certificate Modal Functions
        function openCertificateModal() {
            document.getElementById('certificate-modal').classList.remove('hidden');
        }

        function closeCertificateModal() {
            document.getElementById('certificate-modal').classList.add('hidden');
        }
    </script>
</body>
</html>
